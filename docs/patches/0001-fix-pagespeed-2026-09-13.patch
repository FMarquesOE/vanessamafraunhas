     <link rel="preconnect" href="https://fonts.googleapis.com" />
     <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
+    <!--
+      CSS de fontes carregado sem bloquear o render: com rel="stylesheet" puro
+      o navegador para o primeiro paint até baixar e parsear esse CSS externo
+      (o PageSpeed apontava isso como o maior item de "solicitações que
+      bloqueiam a renderização"). O truque media="print" + onload faz o
+      navegador buscar o arquivo em paralelo, sem tratá-lo como bloqueante, e
+      trocar para "all" assim que chegar. O <noscript> cobre quem navega sem
+      JS.
+    -->
+    <link
+      rel="preload"
+      as="style"
+      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&family=Inter:wght@400;500;600;700&display=swap"
+    />
     <link
       rel="stylesheet"
       href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&family=Inter:wght@400;500;600;700&display=swap"
+      media="print"
+      onload="this.media='all'"
     />
+    <noscript>
+      <link
+        rel="stylesheet"
+        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=DM+Sans:wght@300;400;500&family=Inter:wght@400;500;600;700&display=swap"
+      />
+    </noscript>
